# --------------------------------------------------------------------------
# JCSafeScan backend — example env. Copy to `.env` and fill in real values.
# In production the app refuses to boot if any placeholder value is left as-is
# (see src/config/env.ts).
# --------------------------------------------------------------------------

# development | production
NODE_ENV=development
PORT=4000
APP_NAME=JCSafeScan

# Public base URL of this API (used to build absolute URLs for QR + uploads).
APP_BASE_URL=http://localhost:4000
# Public URL of the scan page (what gets encoded into the QR image).
SCAN_PUBLIC_URL=http://localhost:4000/scan

# Comma-separated allowed origins for CORS (Express + Socket.IO).
# REQUIRED in production. Leave empty in dev to reflect the request origin.
# Example: CORS_ORIGINS=https://app.jcsafescan.com,https://admin.jcsafescan.com
CORS_ORIGINS=

# debug | info | warn | error   (defaults: debug in dev, info in prod)
LOG_LEVEL=

# --------------------------------------------------------------------------
# Database (Postgres via Prisma).
# - Docker/Railway/local: standard connection (port 5432).
# - Vercel (serverless, many short-lived connections): use the Supabase pooler
#   in "Transaction" mode (port 6543) and append ?pgbouncer=true, e.g.:
#     postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres?pgbouncer=true
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jcscantoconnect?schema=public"

# --------------------------------------------------------------------------
# Auth (JWT) — MUST be a long random string in production.
# Generate with:  openssl rand -base64 48
# --------------------------------------------------------------------------
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=30d

# --------------------------------------------------------------------------
# Stripe. Point a webhook at POST /api/payments/webhook (event: checkout.session.completed).
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_QR_PRICE_USD=5.00
STRIPE_SUCCESS_URL=http://localhost:4000/api/payments/success
STRIPE_CANCEL_URL=http://localhost:4000/api/payments/cancel

# --------------------------------------------------------------------------
# Twilio (masked calling via TwiML App + Voice JS SDK).
# The TwiML App's Voice Request URL must be:  POST {APP_BASE_URL}/api/calls/voice-webhook
# --------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACplaceholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_API_KEY_SID=SKplaceholder
TWILIO_API_KEY_SECRET=placeholder
TWILIO_TWIML_APP_SID=APplaceholder
TWILIO_CALLER_ID_NUMBER=+15005550006
TWILIO_MESSAGING_FROM_NUMBER=+15005550006

# --------------------------------------------------------------------------
# Rate limiting  (100 req / 60s across all routes by default; auth/scan/call
# have tighter per-route limits in code).
# --------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --------------------------------------------------------------------------
# Reverse-proxy hops in front of the app. Set to 1 on Render / Fly / Railway
# / Heroku so req.ip and rate limiting see the real client IP from
# X-Forwarded-For. Leave unset locally.
# --------------------------------------------------------------------------
# TRUST_PROXY=1

# --------------------------------------------------------------------------
# Object storage for user-uploaded images (Dog / Luggage photos).
#
# When these are set the uploads module writes to S3 and returns the object URL.
# When they are unset the module falls back to local disk at ./public/uploads.
# On Vercel the filesystem is read-only outside /tmp, so S3 (or R2 / Supabase
# Storage / MinIO) is REQUIRED there for uploads to work.
# --------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only set for non-AWS providers (R2/MinIO/Spaces/Supabase).
S3_ENDPOINT=
# Public URL prefix for GETs. Falls back to https://{bucket}.s3.{region}.amazonaws.com
S3_PUBLIC_BASE_URL=
# Set true for MinIO or any provider that needs path-style URLs.
S3_FORCE_PATH_STYLE=false
