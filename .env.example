# Server
NODE_ENV=development
PORT=4000
APP_NAME=JCSafeScan
APP_BASE_URL=http://localhost:4000
# Public URL of the scan page (what gets encoded into the QR image)
SCAN_PUBLIC_URL=http://localhost:4000/scan

# Database (Postgres via Prisma)
# For traditional hosting (Docker/local): use Supabase's direct connection (port 5432).
# For Vercel (serverless - many short-lived connections): use Supabase's connection
# POOLER instead (Project Settings -> Database -> Connection string -> "Transaction" mode,
# port 6543) and append ?pgbouncer=true, e.g.:
#   postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jcscantoconnect?schema=public"

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Stripe (placeholder test keys - replace with real ones)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_QR_PRICE_USD=5.00
STRIPE_SUCCESS_URL=http://localhost:4000/api/payments/success
STRIPE_CANCEL_URL=http://localhost:4000/api/payments/cancel

# Twilio (placeholder - replace with real Account SID / Auth Token)
TWILIO_ACCOUNT_SID=ACplaceholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_API_KEY_SID=SKplaceholder
TWILIO_API_KEY_SECRET=placeholder
TWILIO_TWIML_APP_SID=APplaceholder
TWILIO_CALLER_ID_NUMBER=+15005550006
TWILIO_MESSAGING_FROM_NUMBER=+15005550006

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
